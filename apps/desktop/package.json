{
  "name": "@diskpush/desktop",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build:renderer": "next build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "start": "electron .",
    "dev": "next dev -p 3210",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@diskpush/database": "workspace:*",
    "@diskpush/fleet-core": "workspace:*",
    "@diskpush/rsync-core": "workspace:*",
    "@diskpush/schemas": "workspace:*",
    "@diskpush/ssh-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.35.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.profullstack.diskpush",
    "productName": "DiskPush",
    "executableName": "diskpush-desktop",
    "copyright": "Copyright (c) 2026 Profullstack, Inc.",
    "directories": {
      "output": "../../release",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/cli",
        "to": "cli"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/launch.sh",
        "to": "launch.sh"
      }
    ],
    "linux": {
      "category": "Utility;FileTransfer;Network",
      "synopsis": "Push files fast. Sync only what changed.",
      "description": "A desktop app and CLI for rsync. Browse servers like FileZilla and transfer with rsync, with resumable incremental sync and direct server-to-server transfers.",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "desktop": {
        "entry": {
          "Keywords": "rsync;sftp;ssh;sync;transfer;backup;",
          "StartupWMClass": "DiskPush"
        }
      },
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "rsync",
        "openssh-client"
      ],
      "afterInstall": "resources/after-install.sh",
      "afterRemove": "resources/after-remove.sh",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@libsql/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "author": {
    "name": "Profullstack, Inc.",
    "email": "hello@profullstack.com"
  },
  "description": "Push files fast. Sync only what changed.",
  "homepage": "https://diskpush.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/profullstack/diskpush.git"
  }
}
