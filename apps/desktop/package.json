{
  "name": "@diskpush/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "build:renderer": "next build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/mark-cjs.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "start": "electron .",
    "dev": "next dev -p 3210",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@diskpush/database": "workspace:*",
    "@diskpush/rsync-core": "workspace:*",
    "@diskpush/schemas": "workspace:*",
    "@diskpush/ssh-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.profullstack.diskpush",
    "productName": "DiskPush",
    "files": ["dist-electron/**/*", "out/**/*", "package.json"],
    "linux": { "category": "Utility", "target": ["AppImage", "deb"] },
    "mac": { "category": "public.app-category.utilities", "target": ["dmg"] }
  }
}
