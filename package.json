{
  "name": "diskpush",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @diskpush/cli build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node apps/cli/dist/bin.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "release": "node scripts/release.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs"
  },
  "devDependencies": {
    "@diskpush/rsync-core": "workspace:*",
    "@diskpush/schemas": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
